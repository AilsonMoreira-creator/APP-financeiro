    "api/lojas-trilha-winback-cron.js": {
      "maxDuration": 120
    },
    "api/ml-reviews-sync-cron.js": {
      "maxDuration": 800
    },
    "api/ml-reviews-analise-cron.js": {
      "maxDuration": 600
    },
    "api/ml-reviews-analise-live.js": {
      "maxDuration": 120
